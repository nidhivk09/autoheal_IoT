# Copy this file to .env and fill in real values locally.
# NEVER commit the real .env file — it is already in .gitignore.

# --- IoT Hub ---
# Service policy connection string (needs "service connect" + "registry read/write"),
# used by Django/controller (fault injection, twin config, rollouts) and the Function.
IOTHUB_CONNECTION_STRING=

# --- Database ---
POSTGRES_URL=postgresql://user:password@localhost:5432/autoheal

# --- Azure auth (service principal, for Functions / management API calls) ---
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_RESOURCE_GROUP=rg-selfhealing-iot
AZURE_IOTHUB_NAME=
# Used by the Function for AKS crash-loop remediation (cloud/functions/shared_code/infra_remediation.py)
AZURE_AKS_CLUSTER_NAME=

# --- Firmware storage (OTA images; see controller/firmware_store.py) ---
FIRMWARE_STORAGE_CONNECTION_STRING=
FIRMWARE_CONTAINER=firmware

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Internal API auth (Function / ingestion service -> Django) ---
INTERNAL_API_TOKEN=
# Base URL of the Django app, as seen by the Function and ingestion service
DJANGO_INTERNAL_API_BASE=http://localhost:8000

# --- Remediation Function ---
# remediation_dispatcher HTTP trigger URL including ?code=<function key>.
# Used by the ingestion service (detections) and Django (approvals).
REMEDIATION_DISPATCH_URL=
# Human escalation: Slack / Discord / Teams incoming webhook URL
ESCALATION_WEBHOOK_URL=
# Used to put incident links in escalation messages
DASHBOARD_BASE_URL=http://localhost:8000

# --- Ingestion service (AKS) ---
IOTHUB_EVENTHUB_COMPATIBLE_CONNECTION_STRING=
IOTHUB_EVENTHUB_COMPATIBLE_PATH=
