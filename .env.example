# Copy this file to .env and fill in real values locally.
# NEVER commit the real .env file — it is already in .gitignore.

# --- IoT Hub ---
IOTHUB_CONNECTION_STRING=
IOTHUB_DEVICE_CONNECTION_STRING=

# --- Database ---
POSTGRES_URL=postgresql://user:password@localhost:5432/autoheal

# --- Azure auth (service principal, for Functions / management API calls) ---
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_RESOURCE_GROUP=rg-selfhealing-iot
AZURE_IOTHUB_NAME=

# --- Raspberry Pi SSH (used by controller/fault_injector.py) ---
PI_SSH_HOST=
PI_SSH_USER=
PI_SSH_KEY_PATH=
PI_NETWORK_IFACE=eth0

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Internal API auth (Function -> Django incident-update endpoint) ---
INTERNAL_API_TOKEN=
