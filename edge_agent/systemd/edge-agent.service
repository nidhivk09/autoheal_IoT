[Unit]
Description=Self-Healing IoT edge agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/autoheal-iot/edge_agent
EnvironmentFile=/opt/autoheal-iot/edge_agent/.env
ExecStart=/opt/autoheal-iot/edge_agent/.venv/bin/python3 /opt/autoheal-iot/edge_agent/agent.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/edge-agent/edge-agent.log
StandardError=append:/var/log/edge-agent/edge-agent.log

# Allow the agent to run the sudo commands its direct methods need
# (systemctl restart, tc qdisc del) without an interactive password prompt.
# Configure this separately via /etc/sudoers.d/edge-agent — see docs/research_notes.md.
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
